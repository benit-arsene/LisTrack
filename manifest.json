{
  "manifest_version": 3,
  "name": "LisTrack - Personal Screen Time Tracker",
  "version": "1.0.0",
  "key": "",
  "description": "Automatically track active screen-time on websites you visit and send it to your remote dashboard.",
  "permissions": [
    "notifications",
    "alarms",
    "storage",
    "contextMenus",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://listrack.onrender.com/*",
    "https://listrack-2.onrender.com/*",
    "http://localhost:3000/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "268748947158-7djicsjlgiapan6q9u63h5ljo248rgbv.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "LisTrack - Open Dashboard",
    "default_popup": "public/html/popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "public/js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "public/js/tracker.js"
      ],
      "run_at": "document_end"
    }
  ]
}
